# Einstellungen für c-logistics. Kopieren nach .env und anpassen:
#   cp .env.example .env
# Die .env wird beim Start gelesen (config/settings.py) und nicht committet.
# Echte Umgebungsvariablen haben Vorrang vor dieser Datei.

# --- Django -----------------------------------------------------------------
# 1 = Entwicklung (Fehlerseiten mit Details), 0 = Betrieb
DJANGO_DEBUG=1
# Geheimer Schlüssel für Sitzungen und CSRF. Für den Betrieb neu erzeugen
# (ohne $ und #, die in .env-Dateien von Compose Ärger machen):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bitte-ersetzen
# Hostnamen, unter denen die App erreichbar ist, durch Komma getrennt
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,crates.c-base.org
# Datenbank: leer = SQLite. Für Postgres:
#   DATABASE_URL=postgres://nutzer:passwort@host:5432/datenbank
# (Im Container mit compose.postgres.yaml wird das automatisch gesetzt.)
DATABASE_URL=
# Ort der SQLite-Datei. Leer = db.sqlite3 im Projektordner; im Container /data/db.sqlite3
DJANGO_SQLITE_PATH=
# Ordner für die hochgeladenen Fotos. Leer = media/ im Projektordner; im Container /data/media
DJANGO_MEDIA_ROOT=

# --- Adresse in QR-Code und NFC-Tag ------------------------------------------
# Endgültige Adresse ohne Schrägstrich am Ende, https://crates.c-base.org
# Muss feststehen, bevor Labels gedruckt werden. Leer = Adresse des Aufrufs.
PUBLIC_BASE_URL=https://crates.c-base.org

# --- Anmeldung über OAuth2 / OpenID Connect ----------------------------------
# Leer = nur lokale Konten. Redirect-URI beim Provider:
#   <PUBLIC_BASE_URL>/accounts/oidc/callback/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
# Name im Anmeldeknopf: „mit … anmelden“
OIDC_PROVIDER_NAME=c-base-account

# --- Bildbeschreibung durch die c-base-KI --------------------------------------
# Jedes hochgeladene Foto geht an dieses Modell, das beschreibt, was zu sehen
# ist. OpenAI-kompatible Adresse bis einschließlich /v1. Leer = aus.
AI_BASE_URL=https://ai.cbrp3.c-base.org/bonsai/v1
AI_MODEL=bonsai
# Nur nötig, wenn die Schnittstelle einen Schlüssel verlangt
AI_API_KEY=
# Sekunden, die auf die Beschreibung eines Fotos gewartet wird
AI_TIMEOUT=180

# --- E-Mail ------------------------------------------------------------------
# Manager erinnern die Verantwortlichen von Crates mit „Needs attention“ per Mail.
# Ohne EMAIL_HOST wird im Betrieb nichts verschickt.
EMAIL_HOST=
# 587 = STARTTLS (Standard). Für Port 465 zusätzlich EMAIL_USE_SSL=1
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=
# Absender der Mails; Antworten gehen an den Manager, der sie ausgelöst hat
DEFAULT_FROM_EMAIL=c-base cargo crates <crates@c-base.org>
# Empfänger ist die Adresse aus dem c-base-Account, sonst <Nutzername>@<Domain>
MEMBER_EMAIL_DOMAIN=c-base.org
# Eine Crate wird frühestens nach so vielen Tagen erneut angemahnt
REMINDER_INTERVAL_DAYS=7

# --- Label --------------------------------------------------------------------
# Wie oft jedes Label und jede Karte gedruckt wird, wenn nichts anderes gewählt ist
PRINT_COPIES=2
# baijamjuree (Nummer in Orbitron), orbitron oder anybody
LABEL_FONT=baijamjuree
# NFC-Logo unter dem QR-Code: 1 = ja, 0 = nein (QR-Code wird dann größer)
LABEL_NFC_LOGO=1
# Druckbreite der Rolle in Pixeln bei 300 dpi: 62 mm = 696, 29 mm = 306
LABEL_WIDTH_PX=696

# --- Container (compose.yaml) ------------------------------------------------
# Adresse und Port, unter denen der Container auf dem Rechner lauscht.
# Der Reverse Proxy mit HTTPS leitet hierher weiter.
APP_BIND=127.0.0.1:27283
# Nur für compose.postgres.yaml: Passwort der Datenbank (Buchstaben, Ziffern, - und _)
POSTGRES_PASSWORD=
# Cookies nur über HTTPS: leer = automatisch (ja, wenn PUBLIC_BASE_URL mit https:// beginnt).
# 0 = aus, um den Container ohne Proxy über http://localhost auszuprobieren
DJANGO_SECURE_COOKIES=
